// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Unit {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  bankAccounts   BankAccount[]
  transactions   Transaction[]
  clients        Client[]
  sales          Sale[]
  purchaseOrders PurchaseOrder[]
  salesRecords   SalesRecord[]
  stockItems     StockItem[]
  marginProducts MarginProduct[]
  fixedExpenses  FixedExpense[]
  marketingMetrics MarketingMetric[]
}

model BankAccount {
  id               Int               @id @default(autoincrement())
  name             String
  unitId           Int
  unit             Unit              @relation(fields: [unitId], references: [id])
  initialBalance   Float             @default(0)
  ofxBankId        String?
  ofxAcctId        String?
  transactions     Transaction[]
  balanceSnapshots BalanceSnapshot[]
}

model Account {
  id           Int           @id @default(autoincrement())
  code         String        @unique
  name         String
  type         String
  dreGroup     String
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

model Transaction {
  id            Int          @id @default(autoincrement())
  date          DateTime
  description   String
  amount        Float
  memo          String?
  fitid         String?      @unique
  accountId     Int?
  account       Account?     @relation(fields: [accountId], references: [id])
  unitId        Int?
  unit          Unit?        @relation(fields: [unitId], references: [id])
  bankAccountId           Int?
  bankAccount             BankAccount? @relation(fields: [bankAccountId], references: [id])
  transferToUnitId        Int?
  transferToBankAccountId Int?
  month                   Int
  year                    Int
  createdAt               DateTime     @default(now())
}

model BalanceSnapshot {
  id            Int         @id @default(autoincrement())
  bankAccountId Int
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])
  date          DateTime
  balance       Float
  createdAt     DateTime    @default(now())

  @@unique([bankAccountId, date])
}

model Client {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  cpf       String?
  unitId    Int?
  unit      Unit?    @relation(fields: [unitId], references: [id])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  sales     Sale[]
}

model Sale {
  id          Int      @id @default(autoincrement())
  clientId    Int
  client      Client   @relation(fields: [clientId], references: [id])
  description String
  amount      Float
  date        DateTime
  unitId      Int?
  unit        Unit?    @relation(fields: [unitId], references: [id])
  month       Int
  year        Int
  createdAt   DateTime @default(now())
}

model Supplier {
  id              Int             @id @default(autoincrement())
  name            String
  cnpj            String?
  contactName     String?
  email           String?
  phone           String?
  paymentTermDays Int             @default(30)
  notes           String?
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  purchaseOrders  PurchaseOrder[]
}

model PurchaseOrder {
  id           Int            @id @default(autoincrement())
  supplierId   Int
  supplier     Supplier       @relation(fields: [supplierId], references: [id])
  unitId       Int?
  unit         Unit?          @relation(fields: [unitId], references: [id])
  status       String         @default("DRAFT")
  expectedDate DateTime?
  receivedDate DateTime?
  totalAmount  Float          @default(0)
  notes        String?
  month        Int
  year         Int
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  items        PurchaseItem[]
}

model PurchaseItem {
  id          Int           @id @default(autoincrement())
  orderId     Int
  order       PurchaseOrder @relation(fields: [orderId], references: [id])
  description String
  quantity    Float
  unitPrice   Float
  receivedQty Float         @default(0)
  notes       String?
}

// Vendas importadas por planilha mensal — alimenta a Curva ABC de Vendas.
// Uma linha por produto por mês/ano/unidade. Re-upload do mesmo período substitui.
model SalesRecord {
  id        Int      @id @default(autoincrement())
  product   String
  sku       String?
  category  String?
  quantity  Float    @default(0)
  revenue   Float    @default(0)
  cost      Float    @default(0)
  unitId    Int?
  unit      Unit?    @relation(fields: [unitId], references: [id])
  month     Int
  year      Int
  createdAt DateTime @default(now())

  @@index([month, year])
}

// Posição de estoque importada por planilha mensal — alimenta a Curva ABC de
// Estoque e os indicadores de giro/cobertura/GMROI (cruzados com o CMV da DRE).
model StockItem {
  id        Int      @id @default(autoincrement())
  product   String
  sku       String?
  category  String?
  quantity  Float    @default(0)
  unitCost  Float    @default(0)
  unitId    Int?
  unit      Unit?    @relation(fields: [unitId], references: [id])
  month     Int
  year      Int
  createdAt DateTime @default(now())

  @@index([month, year])
}

// Produtos com preço e custo de reposição importados por planilha mensal — base
// da Análise de Margem de Contribuição por produto. O rateio de Despesas
// Administrativas e Financeiras é calculado em runtime a partir da DRE do período
// (participação na receita), não é armazenado aqui.
model MarginProduct {
  id              Int      @id @default(autoincrement())
  product         String
  sku             String?
  category        String?
  salePrice       Float    @default(0)
  replacementCost Float    @default(0)
  quantity        Float    @default(0)
  unitId          Int?
  unit            Unit?    @relation(fields: [unitId], references: [id])
  month           Int
  year            Int
  createdAt       DateTime @default(now())

  @@index([month, year])
}

// Indicadores de Marketing / E-commerce por mês (fechamento mensal + Analytics).
// Uma linha por mês/ano/unidade. Guarda os valores REPORTADOS no fechamento
// (ticket, ROAS, conversão etc. como vêm da fonte) — a página deriva apenas as
// variações mês-a-mês. Re-cadastro do mesmo período faz upsert (substitui a linha).
model MarketingMetric {
  id              Int      @id @default(autoincrement())
  month           Int
  year            Int
  unitId          Int?
  unit            Unit?    @relation(fields: [unitId], references: [id])
  revenueBilled   Float    @default(0) // Receita Faturada
  revenueCaptured Float    @default(0) // Receita Captada (site)
  investment      Float    @default(0) // Investimento em mídia (total)
  sessions        Int      @default(0)
  orders          Int      @default(0) // Pedidos / transações
  ticket          Float    @default(0) // Ticket médio reportado
  conversionRate  Float    @default(0) // % (ex.: 1.16)
  roas            Float    @default(0) // ROAS faturado reportado
  cpa             Float    @default(0) // Custo por pedido reportado
  approvalRate    Float    @default(0) // % de aprovação
  paidTrafficPct  Float    @default(0) // % de tráfego pago
  notes           String?
  createdAt       DateTime @default(now())

  @@index([month, year])
}

// Despesas fixas PROJETADAS (contas a pagar futuras) importadas por planilha.
// Uma linha por despesa por mês/ano/unidade — base do Fluxo de Caixa Projetado.
// Re-upload substitui apenas os meses presentes no arquivo.
model FixedExpense {
  id          Int      @id @default(autoincrement())
  description String
  category    String?
  amount      Float    @default(0)
  unitId      Int?
  unit        Unit?    @relation(fields: [unitId], references: [id])
  month       Int
  year        Int
  createdAt   DateTime @default(now())

  @@index([month, year])
}

// Chave/valor para o que precisa sobreviver entre execuções sem virar env var.
// O refresh_token do Mercado Livre é de uso único: cada renovação devolve um novo
// e invalida o anterior, então ele precisa ser gravado, não pode ficar só no .env.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Uma varredura do radar de preços (semanal ou manual).
model RadarScan {
  id             Int          @id @default(autoincrement())
  startedAt      DateTime     @default(now())
  finishedAt     DateTime?
  status         String       @default("rodando") // rodando | concluido | erro | sem_credencial
  origem         String       @default("manual")  // manual | semanal
  produtos       Int          @default(0)         // produtos consultados
  semConcorrente Int          @default(0)         // consultados sem nenhum concorrente válido
  ofertas        Int          @default(0)
  criticos       Int          @default(0)
  erro           String?
  offers         RadarOffer[]

  @@index([startedAt])
}

// Uma oferta de concorrente encontrada para um produto nosso.
model RadarOffer {
  id          Int       @id @default(autoincrement())
  scanId      Int
  scan        RadarScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  sku         String?
  produto     String
  nossoPreco  Float
  mlItemId    String
  titulo      String
  preco       Float
  vendedor    String
  vendedorId  String?
  permalink   String
  freteGratis Boolean   @default(false)
  vendidos    Int       @default(0)
  semelhanca  Float     @default(0)
  divergencia Float                       // positivo = concorrente mais barato
  severidade  String                      // critico | atencao | alinhado | acima
  createdAt   DateTime  @default(now())

  @@index([scanId])
  @@index([severidade])
}

// Venda do Mercado Livre com a data em que o Mercado Pago libera o dinheiro
// (relatório "Vendas a receber"). É o que dá ao Fluxo de Caixa a data REAL de
// cada entrada. Chave = número da transação do Mercado Pago: reenviar um relatório
// que se sobrepõe ao anterior atualiza o status (aprovada → reembolsada) sem duplicar.
model RecebivelML {
  id        String   @id
  compra    String              // AAAA-MM-DD da compra
  liberacao String?             // AAAA-MM-DD da liberação do dinheiro
  status    String              // approved | refunded | cancelled | rejected | in_mediation…
  bruto     Float               // valor do produto
  liquido   Float               // valor total recebido (sem tarifas, frete e parcelamento)
  sku       String?
  pedido    String?             // número da venda no Mercado Livre
  updatedAt DateTime @updatedAt

  @@index([liberacao])
  @@index([compra])
}
